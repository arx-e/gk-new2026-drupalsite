{#
  @file gk-criterion-subcategory.html.twig
  One sub-category inside a category. Uses a nested <details> element.

  Variables:
    subcategory_id    — taxonomy term ID
    subcategory_label — term name
    subcategory_code  — e.g. "1.2"
    criteria          — render array of gk_criterion_row items
    progress          — {answered: int, total: int}
#}
{% set pct = (progress.total > 0) ? ((progress.answered / progress.total * 100)|round) : 0 %}

<div class="gk-subcategory"
     data-subcat-id="{{ subcategory_id }}">

  <details class="gk-subcategory__details" open>
    <summary class="gk-subcategory__summary">
      <span class="gk-subcategory__code">{{ subcategory_code }}</span>
      <span class="gk-subcategory__label">{{ subcategory_label }}</span>
      <span class="gk-subcategory__fraction"
            aria-label="{{ progress.answered }}/{{ progress.total }} {{ 'answered'|t }}">
        {{ progress.answered }}/{{ progress.total }}
      </span>
    </summary>

    <div class="gk-subcategory__body">
      {% for criterion in criteria %}
        {{ criterion }}
      {% endfor %}
    </div>
  </details>
</div>
