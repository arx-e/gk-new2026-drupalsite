{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "~1.7",
        "drupal/admin_toolbar": "^3.6",
        "drupal/asset_injector": "^2.21",
        "drupal/auto_entitylabel": "^3.4",
        "drupal/core-composer-scaffold": "^11.3",
        "drupal/core-project-message": "^11.3",
        "drupal/core-recipe-unpack": "^11.3",
        "drupal/core-recommended": "^11.3",
        "drupal/cshs": "^4.0",
        "drupal/ctools": "^4.1",
        "drupal/custom_field": "^5.0",
        "drupal/diff": "^2.1",
        "drupal/eca": "^3.1",
        "drupal/eca_tamper": "^2.0",
        "drupal/eck": "^2.1",
        "drupal/editablefields": "1.0.x-dev@dev",
        "drupal/empty_fields": "^1.0",
        "drupal/etm": "^2.2@beta",
        "drupal/field_formatter": "^3.0",
        "drupal/field_group": "^4.0",
        "drupal/field_permissions": "^1.5",
        "drupal/filefield_paths": "^1.0@RC",
        "drupal/geofield": "^10.3",
        "drupal/geofield_map": "^11.1",
        "drupal/gin": "^5.0",
        "drupal/gin_login": "^2.1",
        "drupal/gin_toolbar": "^3.0",
        "drupal/history": "^1.0",
        "drupal/image_effects": "^5.0",
        "drupal/imagemagick": "^5.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.8",
        "drupal/migrate_tools": "^6.1",
        "drupal/modeler": "^1.0",
        "drupal/module_filter": "^5.0",
        "drupal/paragraphs": "^1.21",
        "drupal/pathauto": "^1.15",
        "drupal/radix": "^6.0",
        "drupal/redirect": "^1.13",
        "drupal/sam": "^1.3",
        "drupal/tamper": "^1.0@RC",
        "drupal/taxonomy_entity_index": "^1.20",
        "drupal/token": "^1.17",
        "drupal/twig_tweak": "^3.4",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.4",
        "drush/drush": "^13.7"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "drupal/core": {
                "formattable typeerror https://www.drupal.org/project/drupal/issues/3523317": "https://git.drupalcode.org/project/drupal/-/merge_requests/12073.patch"
            },
            "drupal/eck": {
                "add revision support https://www.drupal.org/project/eck/issues/3376678": "https://git.drupalcode.org/project/eck/-/merge_requests/74.patch"
            },
            "drupal/views_bulk_edit": {
                "Support tokens https://www.drupal.org/project/views_bulk_edit/issues/3609449": "https://www.drupal.org/files/issues/2026-07-09/views_bulk_edit-token-text-fields_0.patch"
            } 
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
